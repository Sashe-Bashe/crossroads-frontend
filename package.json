{
  "name": "crossroads-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3100",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3100",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "format": "prettier --write app components lib tests *.ts *.json",
    "format:check": "prettier --check app components lib tests *.ts *.json"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.0"
  }
}
